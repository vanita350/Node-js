<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="View all recipes you've shared on RecipeCraft." />
  <title>My Recipes – RecipeCraft 🍳</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

  <%- include('partials/navbar') %>

  <!-- Page Header -->
  <div class="page-header">
    <div class="page-header-content">
      <h1>📖 My Recipes</h1>
      <p>All the delicious creations you've shared with the community</p>
    </div>
  </div>

  <div class="container">

    <!-- Stats -->
    <div class="stats-bar fade-in-up">
      <div class="stat-item">
        <div class="stat-value"><%= recipes.length %></div>
        <div class="stat-label">Recipes Shared</div>
      </div>
      <div class="stat-item">
        <div class="stat-value">
          <%= recipes.reduce((sum, r) => sum + r.comments.length, 0) %>
        </div>
        <div class="stat-label">Total Comments</div>
      </div>
      <div class="stat-item">
        <div class="stat-value" style="text-transform: capitalize;">
          <%= currentUser.role %>
        </div>
        <div class="stat-label">Account Role</div>
      </div>
    </div>

    <!-- Section Header -->
    <div class="section-header">
      <div>
        <h2 class="section-title">Your Culinary Creations</h2>
        <p class="section-subtitle">Manage and showcase your recipes</p>
      </div>
      <a href="/recipes/new" class="btn btn-primary">✚ Add New Recipe</a>
    </div>

    <!-- Recipe Grid -->
    <% if (recipes.length === 0) { %>
      <div class="empty-state">
        <span class="empty-state-icon">👨‍🍳</span>
        <h3>No recipes yet!</h3>
        <p>You haven't shared any recipes yet. Start cooking and sharing!</p>
        <a href="/recipes/new" class="btn btn-primary btn-lg">Share Your First Recipe 🍴</a>
      </div>
    <% } else { %>
      <div class="recipe-grid">
        <% recipes.forEach(recipe => { %>
          <div class="recipe-card" style="cursor: default;">
            <a href="/recipes/<%= recipe._id %>" style="display: contents;">
              <div class="recipe-card-image">
                <% if (recipe.image) { %>
                  <img src="<%= recipe.image %>" alt="<%= recipe.title %>" loading="lazy" />
                <% } else { %>
                  <div class="recipe-card-image-placeholder">
                    <%= recipe.category === 'Breakfast' ? '🍳' :
                        recipe.category === 'Dessert' ? '🎂' :
                        recipe.category === 'Beverage' ? '🥤' :
                        recipe.category === 'Soup' ? '🍲' :
                        recipe.category === 'Salad' ? '🥗' :
                        recipe.category === 'Snack' ? '🍿' :
                        recipe.category === 'Lunch' ? '🥪' :
                        recipe.category === 'Dinner' ? '🍖' :
                        recipe.category === 'Appetizer' ? '🥘' : '🍴' %>
                  </div>
                <% } %>
                <span class="recipe-category-badge"><%= recipe.category %></span>
                <span class="recipe-difficulty-badge <%= recipe.difficulty %>"><%= recipe.difficulty %></span>
              </div>
            </a>
            <div class="recipe-card-body">
              <a href="/recipes/<%= recipe._id %>">
                <h3 class="recipe-card-title"><%= recipe.title %></h3>
              </a>
              <p class="recipe-card-desc"><%= recipe.description %></p>
              <div class="recipe-card-meta">
                <span class="recipe-meta-item"><span class="icon">⏱</span><%= recipe.cookTime %>m</span>
                <span class="recipe-meta-item"><span class="icon">👥</span><%= recipe.servings %></span>
                <span class="recipe-meta-item"><span class="icon">💬</span><%= recipe.comments.length %></span>
              </div>
              <!-- Action buttons -->
              <div class="d-flex gap-2 flex-wrap mt-2">
                <a href="/recipes/<%= recipe._id %>/edit" class="btn btn-secondary btn-sm">✏️ Edit</a>
                <form action="/recipes/<%= recipe._id %>/delete" method="POST" style="display:inline;"
                      onsubmit="return confirm('Are you sure you want to delete this recipe?')">
                  <button type="submit" class="btn btn-danger btn-sm">🗑️ Delete</button>
                </form>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>

  <footer class="footer">
    <p>Made with ❤️ by <strong>RecipeCraft</strong> &nbsp;|&nbsp; Share the Joy of Cooking 🍳</p>
  </footer>

</body>
</html>
