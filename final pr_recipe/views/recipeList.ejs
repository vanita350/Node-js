<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Discover and share delicious recipes from around the world on RecipeCraft – your culinary community." />
  <title>All Recipes – RecipeCraft 🍳</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

  <%- include('partials/navbar') %>

  <!-- Page Header -->
  <div class="page-header">
    <div class="page-header-content">
      <h1>🍽️ Explore Recipes</h1>
      <p>Discover mouth-watering dishes crafted by our culinary community</p>
    </div>
  </div>

  <div class="container">

    <!-- Search & Filter -->
    <div class="filter-section fade-in-up">
      <form class="filter-form" action="/recipes" method="GET">
        <div class="filter-group">
          <label class="filter-label" for="search-input">🔍 Search</label>
          <input
            id="search-input"
            type="text"
            name="search"
            class="form-input"
            placeholder="Search recipes..."
            value="<%= search %>"
          />
        </div>
        <button type="submit" class="btn-search">Search</button>
        <% if (search || selectedCategory !== 'All') { %>
          <a href="/recipes" class="btn btn-secondary btn-sm" style="align-self:flex-end;">Clear</a>
        <% } %>
      </form>

      <!-- Category Pills -->
      <div class="category-pills">
        <% categories.forEach(cat => { %>
          <a
            href="/recipes?category=<%= cat %><%= search ? '&search=' + search : '' %>"
            class="category-pill <%= selectedCategory === cat ? 'active' : '' %>"
          >
            <%= cat === 'All' ? '🌍 All' :
                cat === 'Breakfast' ? '☀️ ' + cat :
                cat === 'Lunch' ? '🥗 ' + cat :
                cat === 'Dinner' ? '🌙 ' + cat :
                cat === 'Dessert' ? '🎂 ' + cat :
                cat === 'Snack' ? '🍿 ' + cat :
                cat === 'Beverage' ? '🥤 ' + cat :
                cat === 'Soup' ? '🍲 ' + cat :
                cat === 'Salad' ? '🥙 ' + cat :
                cat === 'Appetizer' ? '🥘 ' + cat : '🍴 ' + cat %>
          </a>
        <% }); %>
      </div>
    </div>

    <!-- Stats + Section Header -->
    <div class="section-header mt-3">
      <div>
        <h2 class="section-title">
          <% if (selectedCategory !== 'All') { %>
            <%= selectedCategory %> Recipes
          <% } else if (search) { %>
            Search Results
          <% } else { %>
            All Recipes
          <% } %>
        </h2>
        <p class="section-subtitle"><%= recipes.length %> recipe<%= recipes.length !== 1 ? 's' : '' %> found</p>
      </div>
      <% if (currentUser) { %>
        <a href="/recipes/new" class="btn btn-primary">✚ Add Recipe</a>
      <% } else { %>
        <a href="/register" class="btn btn-secondary">Join to Share 🌟</a>
      <% } %>
    </div>

    <!-- Recipe Grid -->
    <% if (recipes.length === 0) { %>
      <div class="empty-state">
        <span class="empty-state-icon">🥘</span>
        <h3>No recipes found</h3>
        <p>
          <% if (search || selectedCategory !== 'All') { %>
            Try adjusting your search or filters.
          <% } else { %>
            Be the first to share a recipe!
          <% } %>
        </p>
        <% if (currentUser) { %>
          <a href="/recipes/new" class="btn btn-primary">Share Your First Recipe</a>
        <% } else { %>
          <a href="/register" class="btn btn-primary">Get Started 🌟</a>
        <% } %>
      </div>
    <% } else { %>
      <div class="recipe-grid">
        <% recipes.forEach(recipe => { %>
          <a href="/recipes/<%= recipe._id %>" class="recipe-card">
            <div class="recipe-card-image">
              <% if (recipe.image) { %>
                <img src="<%= recipe.image %>" alt="<%= recipe.title %>" loading="lazy" />
              <% } else { %>
                <div class="recipe-card-image-placeholder">
                  <%= recipe.category === 'Breakfast' ? '🍳' :
                      recipe.category === 'Dessert' ? '🎂' :
                      recipe.category === 'Beverage' ? '🥤' :
                      recipe.category === 'Soup' ? '🍲' :
                      recipe.category === 'Salad' ? '🥗' :
                      recipe.category === 'Snack' ? '🍿' :
                      recipe.category === 'Lunch' ? '🥪' :
                      recipe.category === 'Dinner' ? '🍖' :
                      recipe.category === 'Appetizer' ? '🥘' : '🍴' %>
                </div>
              <% } %>
              <span class="recipe-category-badge"><%= recipe.category %></span>
              <span class="recipe-difficulty-badge <%= recipe.difficulty %>"><%= recipe.difficulty %></span>
            </div>
            <div class="recipe-card-body">
              <h3 class="recipe-card-title"><%= recipe.title %></h3>
              <p class="recipe-card-desc"><%= recipe.description %></p>
              <div class="recipe-card-meta">
                <span class="recipe-meta-item"><span class="icon">⏱</span><%= recipe.cookTime %>m</span>
                <span class="recipe-meta-item"><span class="icon">👥</span><%= recipe.servings %></span>
                <span class="recipe-meta-item"><span class="icon">💬</span><%= recipe.comments.length %></span>
                <span class="recipe-card-author">by <%= recipe.author ? recipe.author.username : 'Unknown' %></span>
              </div>
            </div>
          </a>
        <% }); %>
      </div>
    <% } %>
  </div>

  <!-- Footer -->
  <footer class="footer">
    <p>Made with ❤️ by <strong>RecipeCraft</strong> &nbsp;|&nbsp; Share the Joy of Cooking 🍳</p>
  </footer>

</body>
</html>
